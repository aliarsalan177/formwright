{
  "name": "@formwright/ui",
  "version": "0.12.1",
  "description": "Web components built on Formwright's headless foundation: <fw-button>, <fw-input>, <fw-select> and the rest. Framework-free, form-associated, themeable with CSS custom properties, one import path per component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliarsalan177/formwright.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/aliarsalan177/formwright#readme",
  "bugs": "https://github.com/aliarsalan177/formwright/issues",
