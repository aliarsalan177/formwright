{
  "name": "@formwright/ui-core",
  "version": "0.10.0",
  "description": "Headless DOM foundation shared by every Formwright renderer: scoped disposal, reactive bindings, and the behaviours components are built from. Zero dependencies outside @formwright/reactive.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliarsalan177/formwright.git",
    "directory": "packages/ui-core"
  },
  "homepage": "https://github.com/aliarsalan177/formwright#readme",
  "bugs": "https://github.com/aliarsalan177/formwright/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "headless",
    "dom",
    "signals",
    "disposal",
    "memory-leak",
    "formwright"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@formwright/reactive": "workspace:*"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
